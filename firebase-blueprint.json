{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and authentication identity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 25 },
        "email": { "type": "string", "format": "email", "maxLength": 100 },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "phone", "email", "created_at"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized administrator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phone": { "type": "string", "maxLength": 25 },
        "email": { "type": "string", "format": "email", "maxLength": 100 },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "phone", "email", "created_at"]
    },
    "Item": {
      "title": "Item",
      "description": "Marketplace digital document or website portal item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["document", "website"] },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "file_url": { "type": "string", "maxLength": 1000 },
        "file_name": { "type": "string", "maxLength": 200 },
        "file_size": { "type": "number" },
        "website_url": { "type": "string", "maxLength": 1000 },
        "price": { "type": "number" },
        "payment_type": { "type": "string", "enum": ["pay", "free"] },
        "account_numbers": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "title", "description", "price", "payment_type", "status", "created_at"]
    },
    "Order": {
      "title": "Order",
      "description": "Purchase transaction and verification record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "item_id": { "type": "string" },
        "transfer_id": { "type": "string", "maxLength": 100 },
        "sender_name": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "verified"] },
        "created_at": { "type": "string", "format": "date-time" },
        "verified_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "user_id", "item_id", "transfer_id", "sender_name", "status", "created_at"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store contact and default account parameters",
      "type": "object",
      "properties": {
        "admin_whatsapp": { "type": "string", "maxLength": 30 },
        "default_account_numbers": { "type": "string", "maxLength": 1000 }
      },
      "required": ["admin_whatsapp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and customer details"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authorized administrators who can verify orders and manage items"
    },
    "/items/{itemId}": {
      "schema": "Item",
      "description": "Marketplace documents and web portals"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders submitted for verification and unlocking"
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Global store settings"
    }
  }
}
