rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admins Registry
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Items (Documents & Websites)
    match /items/{itemId} {
      allow read, write: if true;
    }

    // Users Collection - customer and admin user profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Customer Orders
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Store Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Default match
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

